# INF-017 / TRAP-09 (harness §5.7, §7.2, §7.3): a base64 EC private key
# planted in a k8s Secret. The real key material is generated at build time
# by harness/build/generate-pki.sh (H3: "No key material committed to
# git.") -- this checked-in file is a TEMPLATE with a placeholder; the real
# file, `pay-tls-secret.yaml`, is gitignored and only exists after running
# generate-pki.sh.
#
# The key reused here is the `pay-edge` role's private key (harness §6) --
# no separate role was added for this trap, per the 2026-09-17 task's scope
# restriction to root-ca/int-ca-ecc/pay-edge/gateway-p12 only.
apiVersion: v1
kind: Secret
metadata:
  name: pay-tls-secret
type: kubernetes.io/tls
data:
  tls.key: "__PAY_EDGE_PRIVATE_KEY_BASE64__"
